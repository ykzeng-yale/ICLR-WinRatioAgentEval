{"task_id": "humaneval/91", "benchmark": "humaneval", "variant": "single_shot", "variant_letter": "A", "trial": 1, "arrival_index": 10, "pair_index": 5, "orientation": 1, "pass": 2, "start_ts": "2026-09-18T14:54:25Z", "n_llm_calls": 1, "prompt_tokens": 158, "completion_tokens": 126, "tokens_estimated": null, "n_executions": 1, "repair_rounds": 0, "self_test_passed": null, "success": true, "sandbox_flag": false, "timed_out": false, "error": null, "final_code": "def is_bored(S):\n    \"\"\"\n    You'll be given a string of words, and your task is to count the number\n    of boredoms. A boredom is a sentence that starts with the word \"I\".\n    Sentences are delimited by '.', '?' or '!'.\n   \n    For example:\n    >>> is_bored(\"Hello world\")\n    0\n    >>> is_bored(\"The sky is blue. The sun is shining. I love this weather\")\n    1\n    \"\"\"\n    import re\n    sentences = re.split(r'[.?!]\\s*', S)\n    return sum(sentence[0:2] == 'I ' for sentence in sentences)\n", "model": "mock-deterministic-v1", "model_kind": "mock", "endpoint": "mock", "harness_git_hash": "cb579f412a959c70b955bcbdddba0524d2c57618", "config_hash": "2dfb51966780698be326a8897c9e384a5513a7c1a47505c42b8a15c6c5baaf5b", "connection_retries": 0, "retry_log": [], "llm_call_seconds": [0.0], "execution_seconds": [0.0184], "self_test_code": "", "verify_stderr": "", "finish_reasons": ["stop"], "response_models": ["mock-deterministic-v1"], "verify_seconds": 0.018409916199743748, "sentinel_seen": true, "hack_flags": [], "static_flags": [], "sandbox_kind": "seatbelt", "sandbox_profile_sha256": "6370c169267c3f31d3df6321b8acd6b3a363619634835c70854a9bf3952ed900", "latency_scope": "llm_calls+self_tests; excludes hidden-test verification", "latency_s": 4.7208741307258606e-05, "entry_point_defined": true, "verify_returncode": 0, "sandbox_limits_applied": "RLIMIT_CPU=10,RLIMIT_NPROC=64", "end_ts": "2026-09-18T14:54:25Z"}
{"task_id": "mbpp/721", "benchmark": "mbpp", "variant": "self_test_repair", "variant_letter": "B", "trial": 1, "arrival_index": 11, "pair_index": 6, "orientation": 1, "pass": 2, "start_ts": "2026-09-18T14:54:25Z", "n_llm_calls": 2, "prompt_tokens": 525, "completion_tokens": 143, "tokens_estimated": null, "n_executions": 2, "repair_rounds": 0, "self_test_passed": true, "success": true, "sandbox_flag": false, "timed_out": false, "error": null, "final_code": "def maxAverageOfPath(cost):\n  N = len(cost)\n  dp = [[0 for i in range(N + 1)] for j in range(N + 1)]\n  dp[0][0] = cost[0][0]\n  for i in range(1, N):\n    dp[i][0] = dp[i - 1][0] + cost[i][0]\n  for j in range(1, N):\n    dp[0][j] = dp[0][j - 1] + cost[0][j]\n  for i in range(1, N):\n    for j in range(1, N):\n      dp[i][j] = max(dp[i - 1][j],\n                     dp[i][j - 1]) + cost[i][j]\n  return dp[N - 1][N - 1] / (2 * N - 1)\n", "model": "mock-deterministic-v1", "model_kind": "mock", "endpoint": "mock", "harness_git_hash": "cb579f412a959c70b955bcbdddba0524d2c57618", "config_hash": "2dfb51966780698be326a8897c9e384a5513a7c1a47505c42b8a15c6c5baaf5b", "connection_retries": 0, "retry_log": [], "llm_call_seconds": [0.0, 0.0], "execution_seconds": [0.0226, 0.0151], "self_test_code": "import inspect\nassert callable(maxAverageOfPath)\nassert \"NotImplementedError\" not in inspect.getsource(maxAverageOfPath)\n", "verify_stderr": "", "finish_reasons": ["stop", "stop"], "response_models": ["mock-deterministic-v1", "mock-deterministic-v1"], "verify_seconds": 0.01513254176825285, "sentinel_seen": true, "hack_flags": [], "static_flags": [], "sandbox_kind": "seatbelt", "sandbox_profile_sha256": "6370c169267c3f31d3df6321b8acd6b3a363619634835c70854a9bf3952ed900", "latency_scope": "llm_calls+self_tests; excludes hidden-test verification", "latency_s": 0.02370299957692623, "entry_point_defined": true, "verify_returncode": 0, "sandbox_limits_applied": "RLIMIT_CPU=10,RLIMIT_NPROC=64", "end_ts": "2026-09-18T14:54:25Z"}
