+// LIVE_AB lifecycle emitter -- definition. See the declaration above.
+// The supervisor's opaque launch token, echoed but never interpreted.
+// Root, 2026-09-22 05:42: "Hand the producer that run/instance token and bound
+// identity; echo it in its records and closing seal ... No need to add another
+// host-digest implementation inside the server." The server proves only that it
+// was launched by that manifest; it does not measure host or boot identity, and
+// this is correlation under a trusted local launch path, not proof that a token
+// could not be invented.
+static const char * live_ab_run_token() {
+    static const char * tok = getenv("LIVE_AB_RUN_TOKEN");
+    return (tok && tok[0]) ? tok : "";
+}
+
+// A persistent acquisition-invalid state. Root: "The producer must not silently
+// lose failed writes ... propagate a persistent acquisition-invalid state to the
+// supervisor. If the log cannot record its own failure, the supervisor must
+// retain the error/process failure and refuse that acquisition."
+static std::atomic<long long> live_ab_seq{0};
+static std::atomic<long long> live_ab_write_failures{0};
+
+//: Failures of the BEST-EFFORT failure channel itself.
+static std::atomic<long long> live_ab_sidecar_failures{0};
+
+//: THE PROCESS-LEVEL REFUSAL. Root, 2026-09-23 08:00, choosing between the two
+//: options put to it:
+//:
+//:   "Root chooses process-level refusal for unrecordable producer failure.
+//:    Failure to persist the sidecar must produce a deterministic nonzero
+//:    process outcome, including after final seal formatting/flush/close; do not
+//:    depend on another log write or an unbounded stderr flush. Avoid reentering
+//:    normal static-destructor exit handling."
+//:
+//: The previous revision reported on stderr and carried a counter in the seal.
+//: Both are writes that can themselves fail, and the supervisor does not drain
+//: the supplied pipe, so neither is an OUTCOME. An exit status is.
+#define LIVE_AB_EXIT_UNRECORDABLE 93
+
+//: Bounded, async-signal-safe, and never buffered: one write(2) of at most
+//: sizeof(buf) to fd 2. NOT an fprintf/fflush pair -- a blocked or full stderr
+//: must not be able to stall or swallow the refusal, and the diagnostic is a
+//: courtesy while the EXIT STATUS is the evidence.
+// [[noreturn]] so the caller's flow analysis knows the null-FILE branch below
+// does not fall through into a use of that null pointer.
+[[noreturn]] static void live_ab_die_unrecordable(const char * what) {
+    char buf[192];
+    const int n = snprintf(buf, sizeof(buf),
+            "live_ab: unrecordable '%s' write failure; refusing acquisition "
+            "with exit %d\n", what, LIVE_AB_EXIT_UNRECORDABLE);
+    if (n > 0) {
+        ssize_t ignored = write(2, buf, (size_t) (n < (int) sizeof(buf)
+                                                  ? n : (int) sizeof(buf) - 1));
+        (void) ignored;          // best effort; the exit status is the outcome
+    }
+    // _exit, NOT exit/abort: it runs no atexit handler and no static
+    // destructor, so it cannot re-enter the seal writer that may have called
+    // us. Whatever was already durably written STAYS written -- root:
+    // "Preserve available observations on failure."
+    _exit(LIVE_AB_EXIT_UNRECORDABLE);
+}
+
+static void live_ab_note_write_failure(const char * path, const char * what) {
+    live_ab_write_failures.fetch_add(1);
+    // BEST EFFORT, AND ONLY THAT. On a SEPARATE file so a failing log cannot
+    // hide its own failure by failing again -- but a separate filename does not
+    // make persistence reliable. When THIS writer fails, every step's result is
+    // checked and the process refuses: a full disk used to make a terminal write
+    // failure completely invisible -- no sidecar line, and nothing anywhere else
+    // saying one had been attempted.
+    std::string err = std::string(path) + ".error";
+    FILE * f = fopen(err.c_str(), "ab");
+    if (f == nullptr) {
+        live_ab_sidecar_failures.fetch_add(1);
+        live_ab_die_unrecordable(what);
+    }
+    const int n = fprintf(f,
+               "{\"schema\":\"live_ab/acquisition_error-v1\",\"stage\":\"%s\","
+               "\"t_us\":%lld,\"failures\":%lld}\n",
+            what, (long long) ggml_time_us(),
+            (long long) live_ab_write_failures.load());
+    // flush and close checked INDEPENDENTLY: `fflush(f) || fclose(f)`
+    // short-circuits and never closes on a flush failure, leaking the handle
+    // AND discarding the close result, which on a buffered stream is where a
+    // write error usually surfaces.
+    const int flushed = fflush(f);
+    const int closed  = fclose(f);
+    if (n <= 0 || flushed != 0 || closed != 0) {
+        live_ab_sidecar_failures.fetch_add(1);
+        live_ab_die_unrecordable(what);
+    }
+}
+
+static void live_ab_emit_lifecycle(const server_slot & slot) {
+    static const char * path = getenv("LIVE_AB_LIFECYCLE_LOG");
+    if (path == nullptr || path[0] == '\0') {
+        return;                      // instrumentation off: upstream behaviour
+    }
+    static std::mutex mtx;           // one writer at a time; slots release concurrently
+    static const std::string instance_id = [] {
+        const char * tok = live_ab_run_token();
+        if (tok[0]) {
+            return std::string(tok);     // the supervisor names the instance
+        }
+        char buf[64];
+        snprintf(buf, sizeof(buf), "srv_%lld_%d",
+                 (long long) ggml_time_us(), (int) getpid());
+        return std::string(buf);
+    }();
+
+    // A lifecycle is COMPLETE only if every transition was observed. A slot that
+    // never reached prompt processing, or never generated, is emitted with
+    // complete=false and MUST NOT be used to certify coverage.
+    const bool complete = slot.stats.t_assigned > 0 && slot.stats.t_start > 0 &&
+                          slot.stats.t_gen_last > 0 && slot.stats.t_released > 0 &&
+                          slot.stats.t_start >= slot.stats.t_assigned &&
+                          slot.stats.t_gen_last >= slot.stats.t_start &&
+                          slot.stats.t_released >= slot.stats.t_gen_last;
+
+    const long long seq = live_ab_seq.fetch_add(1);
+    char line[1280];
+    const int n = snprintf(line, sizeof(line),
+        "{\"schema\":\"live_ab/slot_lifecycle-v1\",\"seq\":%lld,"
+        "\"run_token\":\"%s\","
+        "\"instance_id\":\"%s\",\"slot_id\":%d,\"task_id\":%d,"
+        "\"clock\":\"clock_gettime(CLOCK_MONOTONIC)\",\"units\":\"microseconds\","
+        "\"t_assigned_us\":%lld,\"t_prompt_start_us\":%lld,"
+        "\"t_gen_last_us\":%lld,\"t_released_us\":%lld,"
+        "\"n_prompt_processed\":%llu,\"n_gen\":%llu,"
+        "\"complete\":%s,\"means\":\"occupied decoding slot, not uninterrupted "
+        "hardware utilization\"}\n",
+        seq, live_ab_run_token(), instance_id.c_str(), slot.id,
+        slot.task ? slot.task->id : -1,
+        (long long) slot.stats.t_assigned, (long long) slot.stats.t_start,
+        (long long) slot.stats.t_gen_last, (long long) slot.stats.t_released,
+        (unsigned long long) slot.stats.n_prompt_processed,
+        (unsigned long long) slot.stats.n_gen,
+        complete ? "true" : "false");
+    if (n <= 0 || n >= (int) sizeof(line)) {
+        live_ab_note_write_failure(path, "format");
+        return;                      // never emit a truncated record
+    }
+
+    std::lock_guard<std::mutex> lock(mtx);
+    FILE * f = fopen(path, "ab");
+    if (f == nullptr) {
+        live_ab_note_write_failure(path, "open");
+        return;
+    }
+    // Write until every byte is accepted, then flush: a partially written record
+    // is worse than none, because it would be read as a real one.
+    size_t off = 0;
+    while (off < (size_t) n) {
+        const size_t w = fwrite(line + off, 1, (size_t) n - off, f);
+        if (w == 0) {
+            live_ab_note_write_failure(path, "write");
+            break;
+        }
+        off += w;
+    }
+    if (off < (size_t) n) {
+        fclose(f);
+        return;                      // partial bytes preserved, failure recorded
+    }
+    // Independent, and in this order: flush reports the buffered write, close
+    // reports the final one. Neither result may be skipped because the other
+    // failed.
+    const int rec_flush = fflush(f);
+    const int rec_close = fclose(f);
+    if (rec_flush != 0) {
+        live_ab_note_write_failure(path, "flush");
+    }
+    if (rec_close != 0) {
+        live_ab_note_write_failure(path, "close");
+    }
+}
+
+// THE CLOSING SEAL. A newline-terminated subset of records is not a complete
+// acquisition: without a seal the reader cannot tell a finished log from one
+// whose writer died. Emitted from a static destructor so it runs on ordinary
+// process exit; a crash leaves NO seal, which is the correct signal.
+struct live_ab_seal_writer {
+    ~live_ab_seal_writer() {
+        const char * path = getenv("LIVE_AB_LIFECYCLE_LOG");
+        if (path == nullptr || path[0] == '\0') {
+            return;
+        }
+        FILE * f = fopen(path, "ab");
+        if (f == nullptr) {
+            live_ab_note_write_failure(path, "seal_open");
+            return;
+        }
+        // THE WRITE RESULT IS CAPTURED. Root, 2026-09-22 06:57: "the seal's
+        // fprintf(...) is still a bare call whose return is discarded. The
+        // claimed 'seal fprintf result is checked' IS NOT PRESENT."
+        // Correct: I claimed this repair in a commit message and had not made
+        // it -- a guarded replacement silently did not match and I did not look.
+        // fprintf returns the bytes written, or NEGATIVE on error; a short
+        // count means a truncated seal, which is worse than no seal because it
+        // parses as nothing while looking like something.
+        // `sidecar_failures` rides in the seal so that a lost sidecar is still
+        // DETECTABLE from the log alone: the count of failures of the failure
+        // channel is the one number the sidecar cannot carry about itself.
+        const int seal_written = fprintf(f,
+                   "{\"schema\":\"live_ab/acquisition_seal-v1\",\"run_token\":\"%s\","
+                   "\"records\":%lld,\"write_failures\":%lld,"
+                   "\"sidecar_failures\":%lld,\"t_us\":%lld,"
+                   "\"clock\":\"clock_gettime(CLOCK_MONOTONIC)\"}\n",
+                live_ab_run_token(), (long long) live_ab_seq.load(),
+                (long long) live_ab_write_failures.load(),
+                (long long) live_ab_sidecar_failures.load(),
+                (long long) ggml_time_us());
+        if (seal_written <= 0) {
+            live_ab_note_write_failure(path, "seal_format");
+        }
+        // FLUSH AND CLOSE ARE CHECKED INDEPENDENTLY. Root, 2026-09-22 06:16:
+        // "The current fflush(...) || fclose(...) skips close on flush failure;
+        // a later seal-close error is invisible to a reader that ignores the
+        // sidecar." Short-circuit evaluation meant a failing flush never called
+        // fclose at all -- leaking the handle AND discarding the close result,
+        // which on a buffered stream is where a write error usually surfaces.
+        const int seal_flush = fflush(f);
+        const int seal_close = fclose(f);
+        if (seal_flush != 0) {
+            live_ab_note_write_failure(path, "seal_flush");
+        }
+        if (seal_close != 0) {
+            live_ab_note_write_failure(path, "seal_close");
+        }
+    }
+};
+static live_ab_seal_writer live_ab_seal_writer_instance;
+
