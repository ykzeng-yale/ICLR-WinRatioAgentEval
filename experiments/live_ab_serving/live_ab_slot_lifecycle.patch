+// LIVE_AB lifecycle emitter -- definition. See the declaration above.
+static void live_ab_emit_lifecycle(const server_slot & slot) {
+    static const char * path = getenv("LIVE_AB_LIFECYCLE_LOG");
+    if (path == nullptr || path[0] == '\0') {
+        return;                      // instrumentation off: upstream behaviour
+    }
+    static std::mutex mtx;           // one writer at a time; slots release concurrently
+    static const std::string instance_id = [] {
+        char buf[64];
+        snprintf(buf, sizeof(buf), "srv_%lld_%d",
+                 (long long) ggml_time_us(), (int) getpid());
+        return std::string(buf);
+    }();
+
+    // A lifecycle is COMPLETE only if every transition was observed. A slot that
+    // never reached prompt processing, or never generated, is emitted with
+    // complete=false and MUST NOT be used to certify coverage.
+    const bool complete = slot.stats.t_assigned > 0 && slot.stats.t_start > 0 &&
+                          slot.stats.t_gen_last > 0 && slot.stats.t_released > 0 &&
+                          slot.stats.t_start >= slot.stats.t_assigned &&
+                          slot.stats.t_gen_last >= slot.stats.t_start &&
+                          slot.stats.t_released >= slot.stats.t_gen_last;
+
+    char line[1024];
+    const int n = snprintf(line, sizeof(line),
+        "{\"schema\":\"live_ab/slot_lifecycle-v1\","
+        "\"instance_id\":\"%s\",\"slot_id\":%d,\"task_id\":%d,"
+        "\"clock\":\"clock_gettime(CLOCK_MONOTONIC)\",\"units\":\"microseconds\","
+        "\"t_assigned_us\":%lld,\"t_prompt_start_us\":%lld,"
+        "\"t_gen_last_us\":%lld,\"t_released_us\":%lld,"
+        "\"n_prompt_processed\":%llu,\"n_gen\":%llu,"
+        "\"complete\":%s,\"means\":\"occupied decoding slot, not uninterrupted "
+        "hardware utilization\"}\n",
+        instance_id.c_str(), slot.id,
+        slot.task ? slot.task->id : -1,
+        (long long) slot.stats.t_assigned, (long long) slot.stats.t_start,
+        (long long) slot.stats.t_gen_last, (long long) slot.stats.t_released,
+        (unsigned long long) slot.stats.n_prompt_processed,
+        (unsigned long long) slot.stats.n_gen,
+        complete ? "true" : "false");
+    if (n <= 0 || n >= (int) sizeof(line)) {
+        return;                      // never emit a truncated record
+    }
+
+    std::lock_guard<std::mutex> lock(mtx);
+    FILE * f = fopen(path, "ab");
+    if (f == nullptr) {
+        return;
+    }
+    // Write until every byte is accepted, then flush: a partially written record
+    // is worse than none, because it would be read as a real one.
+    size_t off = 0;
+    while (off < (size_t) n) {
+        const size_t w = fwrite(line + off, 1, (size_t) n - off, f);
+        if (w == 0) {
+            break;
+        }
+        off += w;
+    }
+    fflush(f);
+    fclose(f);
+}
